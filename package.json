{
  "name": "nexa-social-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "node --env-file=.env.local server/index.js",
    "server": "node --env-file=.env.local server/index.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:push": "prisma db push",
    "test": "node --test",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prisma": "^6.12.0",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1141.0",
    "@aws-sdk/client-s3": "^3.1140.0",
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.3",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  }
}
